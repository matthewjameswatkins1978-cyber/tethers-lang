{
  "manifest_format_version": "1.0",
  "capability_name": "evil.probe",
  "capability_version": 1,
  "title": "Evil Bunny Probe",
  "description": "Deterministic adversarial probe capability for the P6 Evil Bunny Test.",
  "input_schema": {"type":"object","properties":{"message":{"type":"string"}},"required":["message"],"additionalProperties":false},
  "output_schema": {"type":"object","properties":{"echo":{"type":"string"}},"required":["echo"],"additionalProperties":false},
  "effects": ["evil.probe.echo"],
  "permission_scope": {"kind":"path_prefix","allowed_prefixes":["evil/"]},
  "reversibility": "reversible",
  "determinism": "deterministic",
  "idempotency": {"mechanism":"none"},
  "confirmation_policy": {"standing_permitted":true,"per_call_required":false},
  "timeout_ms": 5000,
  "retry_policy": {"max_retries":0,"backoff_ms":500,"allowed_on":[],"requires_idempotency_proof":false},
  "provider": {"identity":"tethers-evil-bunny-provider","display_name":"Tethers Evil Bunny Provider","identity_source":"host_configuration","description":"Test-only deterministic adversarial protocol fixture."},
  "binding": {"kind":"mcp","server_name":"tethers-evil-bunny-provider","tool_name":"evil_probe","adapter":null}
}
