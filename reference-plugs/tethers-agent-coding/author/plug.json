{
  "package_format_version":"1",
  "package_id":"tethers.agent-coding",
  "package_version":"0.1.0",
  "display_name":"Tethers Agent Coding",
  "description":"Structured Git, bounded argv-only process execution, and named verification capabilities for agents.",
  "publisher":"tethers",
  "licence":"MIT",
  "socket_major":1,
  "protocol_bindings":[{"protocol":"MCP","version":"2025-11-25","transport":"stdio"}],
  "platforms":[{"os":"windows","architecture":"x86_64"}],
  "provider":{
    "provider_id":"tethers-agent-coding",
    "provider_version":"0.1.0",
    "launch":{"path":"provider/agent_coding_provider.exe","arguments":[]},
    "working_directory":"provider",
    "capability_operation_namespace":"tethers.agent.coding",
    "operational_scope_schema":{
      "type":"object",
      "properties":{
        "repository_root":{"type":"string","minLength":1},
        "process_cwd_root":{"type":"string","minLength":1},
        "allowed_programs":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"string","minLength":1,"maxLength":16384}},
        "max_runtime_ms":{"type":"integer","minimum":1,"maximum":120000},
        "max_output_bytes":{"type":"integer","minimum":1,"maximum":16777216},
        "allowed_environment_keys":{"type":"array","maxItems":64,"items":{"type":"string","maxLength":16384}},
        "verification_checks":{"type":"object","maxProperties":64,"additionalProperties":{"type":"object"}}
      },
      "required":["repository_root","process_cwd_root","allowed_programs","max_runtime_ms","max_output_bytes","allowed_environment_keys","verification_checks"],
      "additionalProperties":false
    }
  },
  "capabilities":[
    {"capability_name":"git.status","capability_version":1,"manifest_path":"manifests/git-status-v1.json","provider_operation_name":"git_status"},
    {"capability_name":"git.diff","capability_version":1,"manifest_path":"manifests/git-diff-v1.json","provider_operation_name":"git_diff"},
    {"capability_name":"git.log","capability_version":1,"manifest_path":"manifests/git-log-v1.json","provider_operation_name":"git_log"},
    {"capability_name":"git.show","capability_version":1,"manifest_path":"manifests/git-show-v1.json","provider_operation_name":"git_show"},
    {"capability_name":"git.branch_list","capability_version":1,"manifest_path":"manifests/git-branch-list-v1.json","provider_operation_name":"git_branch_list"},
    {"capability_name":"git.branch_current","capability_version":1,"manifest_path":"manifests/git-branch-current-v1.json","provider_operation_name":"git_branch_current"},
    {"capability_name":"git.add","capability_version":1,"manifest_path":"manifests/git-add-v1.json","provider_operation_name":"git_add"},
    {"capability_name":"git.branch_create","capability_version":1,"manifest_path":"manifests/git-branch-create-v1.json","provider_operation_name":"git_branch_create"},
    {"capability_name":"git.checkout","capability_version":1,"manifest_path":"manifests/git-checkout-v1.json","provider_operation_name":"git_checkout"},
    {"capability_name":"git.commit","capability_version":1,"manifest_path":"manifests/git-commit-v1.json","provider_operation_name":"git_commit"},
    {"capability_name":"process.execute","capability_version":1,"manifest_path":"manifests/process-execute-v1.json","provider_operation_name":"process_execute"},
    {"capability_name":"verification.run","capability_version":1,"manifest_path":"manifests/verification-run-v1.json","provider_operation_name":"verification_run"}
  ],
  "payloads":[
    {"path":"provider/agent_coding_provider.exe","role":"provider_executable"},
    {"path":"manifests/git-status-v1.json","role":"capability_manifest"},
    {"path":"manifests/git-diff-v1.json","role":"capability_manifest"},
    {"path":"manifests/git-log-v1.json","role":"capability_manifest"},
    {"path":"manifests/git-show-v1.json","role":"capability_manifest"},
    {"path":"manifests/git-branch-list-v1.json","role":"capability_manifest"},
    {"path":"manifests/git-branch-current-v1.json","role":"capability_manifest"},
    {"path":"manifests/git-add-v1.json","role":"capability_manifest"},
    {"path":"manifests/git-branch-create-v1.json","role":"capability_manifest"},
    {"path":"manifests/git-checkout-v1.json","role":"capability_manifest"},
    {"path":"manifests/git-commit-v1.json","role":"capability_manifest"},
    {"path":"manifests/process-execute-v1.json","role":"capability_manifest"},
    {"path":"manifests/verification-run-v1.json","role":"capability_manifest"}
  ]
}
