{
  "manifest_format_version": "1.0",
  "capability_name": "text.stats",
  "capability_version": 1,
  "title": "Bounded Text Statistics",
  "description": "Read bounded basic statistics from one UTF-8 text file inside a host-approved query root without a text library.",
  "input_schema": {"type":"object","properties":{"path":{"type":"string"}},"required":["path"],"additionalProperties":false},
  "output_schema": {"type":"object","properties":{"path":{"type":"string"},"size_bytes":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"line_count":{"type":"integer","minimum":0},"word_count":{"type":"integer","minimum":0},"character_count":{"type":"integer","minimum":0}},"required":["path","size_bytes","sha256","line_count","word_count","character_count"],"additionalProperties":false},
  "effects": ["data.read"],
  "permission_scope": {"kind":"path_prefix","allowed_prefixes":["query/"]},
  "reversibility": "reversible",
  "determinism": "deterministic",
  "idempotency": {"mechanism":"none"},
  "confirmation_policy": {"standing_permitted":true,"per_call_required":false},
  "timeout_ms": 5000,
  "retry_policy": {"max_retries":0,"backoff_ms":0,"allowed_on":[],"requires_idempotency_proof":false},
  "provider": {"identity":"tethers-text-stats-provider","display_name":"Tethers Text Stats Provider","identity_source":"host_configuration","description":"Credential-free local UTF-8 text statistics provider."},
  "binding": {"kind":"mcp","server_name":"tethers-text-stats-provider","tool_name":"text_stats","adapter":null}
}
