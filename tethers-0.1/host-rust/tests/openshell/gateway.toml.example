[openshell]
version = 1

[openshell.gateway]
bind_address = "127.0.0.1:17670"
compute_drivers = ["docker"]

[openshell.gateway.tls]
cert_path = "/home/REPLACE_ME/.local/state/openshell/tls/server/tls.crt"
key_path = "/home/REPLACE_ME/.local/state/openshell/tls/server/tls.key"
require_client_auth = false

[openshell.gateway.gateway_jwt]
signing_key_path = "/home/REPLACE_ME/.local/state/openshell/tls/jwt/signing.pem"
public_key_path = "/home/REPLACE_ME/.local/state/openshell/tls/jwt/public.pem"
kid_path = "/home/REPLACE_ME/.local/state/openshell/tls/jwt/kid"
gateway_id = "lantern-m4"
ttl_secs = 3600

[openshell.gateway.auth]
allow_unauthenticated_users = true
