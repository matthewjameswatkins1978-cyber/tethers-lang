{
  "schema_version": "1",
  "name": "coding-agent-default",
  "policy_version": "1.0.0",
  "default": "deny",
  "rules": [
    {"name":"workspace.read","decision":"allow","reason":"workspace inspection is passive"},
    {"name":"filesystem.read","decision":"allow","reason":"workspace inspection is passive"},
    {"name":"filesystem.list","decision":"allow","reason":"workspace inspection is passive"},
    {"name":"filesystem.stat","decision":"allow","reason":"workspace inspection is passive"},
    {"name":"filesystem.write","decision":"allow","reason":"workspace-local reversible change"},
    {"name":"filesystem.create","decision":"allow","reason":"workspace-local reversible change"},
    {"name":"filesystem.append","decision":"allow","reason":"workspace-local reversible change"},
    {"name":"filesystem.rename","decision":"allow","reason":"workspace-local reversible change"},
    {"name":"filesystem.copy","decision":"allow","reason":"workspace-local reversible change"},
    {"name":"filesystem.mkdir","decision":"allow","reason":"workspace-local reversible change"},
    {"name":"filesystem.delete","decision":"deny","reason":"destructive file deletion is prohibited"},
    {"name":"filesystem.write_outside_workspace","decision":"deny","reason":"writes outside the workspace are prohibited"},
    {"name":"process.execute","decision":"allow","reason":"declared non-shell process execution"},
    {"name":"process.spawn","decision":"ask","reason":"new process execution requires approval"},
    {"name":"process.execute_shell","decision":"ask","reason":"shell execution requires human authority"},
    {"name":"shell.execute","decision":"ask","reason":"shell execution requires human authority"},
    {"name":"shell.pipeline","decision":"ask","reason":"shell pipelines require human authority"},
    {"name":"shell.redirect","decision":"ask","reason":"shell redirection requires human authority"},
    {"name":"process.kill","decision":"ask","reason":"process termination requires human authority"},
    {"name":"process.elevated","decision":"deny","reason":"elevation is prohibited"},
    {"name":"git.status","decision":"allow","reason":"repository inspection is passive"},
    {"name":"git.diff","decision":"allow","reason":"repository inspection is passive"},
    {"name":"git.log","decision":"allow","reason":"repository inspection is passive"},
    {"name":"git.show","decision":"allow","reason":"repository inspection is passive"},
    {"name":"git.branch.read","decision":"allow","reason":"repository inspection is passive"},
    {"name":"git.branch","decision":"allow","reason":"local branch inspection is reversible"},
    {"name":"git.commit","decision":"allow","reason":"commit is permitted when project scope allows it"},
    {"name":"git.add","decision":"allow","reason":"staging is local and reversible"},
    {"name":"git.push","decision":"ask","reason":"remote repository mutation requires human approval"},
    {"name":"git.force_push","decision":"deny","reason":"force pushes are prohibited"},
    {"name":"git.merge","decision":"ask","reason":"history mutation requires human approval"},
    {"name":"git.tag","decision":"ask","reason":"release marking requires human approval"},
    {"name":"git.reset_destructive","decision":"deny","reason":"destructive history rewrites are prohibited"},
    {"name":"network.http_get","decision":"allow","reason":"read-only HTTP access"},
    {"name":"network.http_head","decision":"allow","reason":"read-only HTTP access"},
    {"name":"network.http_post","decision":"ask","reason":"remote mutation requires human approval"},
    {"name":"network.download","decision":"ask","reason":"external data acquisition requires human approval"},
    {"name":"network.upload","decision":"ask","reason":"external data publication requires human approval"},
    {"name":"network.arbitrary","decision":"deny","reason":"unbounded network access is prohibited"},
    {"name":"secret.read","decision":"deny","reason":"secret material must not be read"},
    {"name":"secret.use","decision":"ask","reason":"secret use requires human authority"},
    {"name":"secret.write","decision":"deny","reason":"secret mutation is prohibited"},
    {"name":"secret.expose","decision":"deny","reason":"secret disclosure is prohibited"},
    {"name":"secret.export","decision":"deny","reason":"secret export is prohibited"},
    {"name":"container.build","decision":"ask","reason":"container build may execute untrusted build instructions"},
    {"name":"container.run","decision":"ask","reason":"container execution requires approval"},
    {"name":"container.exec","decision":"ask","reason":"container execution requires approval"},
    {"name":"container.privileged","decision":"deny","reason":"privileged containers are prohibited"},
    {"name":"tool.call","decision":"ask","reason":"generic tool calls require approval"},
    {"name":"mcp.tool_call","decision":"ask","reason":"MCP tool calls require approval"},
    {"name":"database.connect","decision":"ask","reason":"external database access requires approval"},
    {"name":"database.read","decision":"ask","reason":"database access requires approval"},
    {"name":"database.write","decision":"deny","reason":"database mutation is prohibited by default"},
    {"name":"message.draft","decision":"allow","reason":"drafting has no external consequence"},
    {"name":"message.send","decision":"ask","reason":"external messaging requires approval"},
    {"name":"email.draft","decision":"allow","reason":"drafting has no external consequence"},
    {"name":"email.send","decision":"ask","reason":"external email requires approval"},
    {"name":"deploy.preview","decision":"ask","reason":"deployment changes external state"},
    {"name":"deploy.production","decision":"deny","reason":"production deployment is prohibited by default"},
    {"name":"apply_patch","decision":"allow","reason":"scoped workspace edit"},
    {"name":"test.run","decision":"allow","reason":"verification is passive"}
  ]
}
