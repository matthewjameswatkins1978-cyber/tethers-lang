{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,"required":["schema_version","actor","action","resource","context"],
  "properties":{
    "schema_version":{"const":"1"},"actor":{"type":"string","minLength":1},"action":{"type":"string","pattern":"^[A-Za-z0-9_.-]+$"},"resource":{"type":"string","minLength":1},"context":{"type":"object"},
    "scope":{"type":"object","additionalProperties":false,"properties":{"allowed_files":{"type":"array","items":{"type":"string"}},"allowed_actions":{"type":"array","items":{"type":"string"}},"workspace_root":{"type":"string"}}}
  }
}
