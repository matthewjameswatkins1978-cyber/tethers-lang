{
  "name": "@callpermit/core",
  "version": "0.1.0",
  "description": "Self-contained Tethers-backed authority-envelope evaluator for CALL-E",
  "type": "module",
  "main": "dist/callpermit.js",
  "types": "dist/callpermit.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "dry-run": "node --import tsx src/cli.ts",
    "tethers-check": "node --import tsx src/tethers-proof.ts",
    "acceptance": "npm ci && npm run build && npm test && npm run dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "tethers",
    "authority",
    "call-e"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@call-e/calle": "0.7.0"
  }
}
